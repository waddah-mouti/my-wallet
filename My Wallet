<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Wallets</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>💰</text></svg>">
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#F5F4F0;--surface:#FFF;--surface2:#EEECEA;
  --border:rgba(0,0,0,0.07);--border-strong:rgba(0,0,0,0.13);
  --text:#1A1917;--text2:#6B6860;--text3:#9E9C96;
  --work:#185FA5;--work-bg:#E6F1FB;
  --personal:#0F6E56;--personal-bg:#E1F5EE;
  --cash:#7C3AED;--cash-bg:#EDE9FE;
  --debt-owe:#DC2626;--debt-owe-bg:#FEE2E2;
  --debt-own:#059669;--debt-own-bg:#D1FAE5;
  --income:#0F6E56;--expense:#A32D2D;
  --note:#B45309;--note-bg:#FEF3C7;
  --commit:#0369A1;--commit-bg:#E0F2FE;
  --repure:#2D6A4F;--repure-bg:#D8F3DC;
  --r:14px;--rs:9px;
}
@media(prefers-color-scheme:dark){:root{
  --bg:#0F0F12;--surface:#1C1C22;--surface2:#16161C;
  --border:rgba(255,255,255,0.07);--border-strong:rgba(255,255,255,0.13);
  --text:#F4F4F5;--text2:#A1A1AA;--text3:#52525B;
  --work:#60A5FA;--work-bg:#1E3A5F;--personal:#34D399;--personal-bg:#064E3B;
  --cash:#A78BFA;--cash-bg:#3B1F6E;--repure:#52B788;--repure-bg:#1B4332;
  --debt-owe:#F87171;--debt-owe-bg:#450A0A;--debt-own:#6EE7B7;--debt-own-bg:#022C22;
  --income:#34D399;--expense:#F87171;--note:#FCD34D;--note-bg:#451A03;--commit:#38BDF8;--commit-bg:#0C2340;
}}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;}
body{font-family:'Cairo',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;}
.app{max-width:480px;margin:0 auto;padding-bottom:90px;}
header{padding:16px 20px 10px;display:flex;align-items:center;justify-content:space-between;}
.logo-text{font-size:17px;font-weight:700;}
.logo-sub{font-size:11px;color:var(--text3);}
.sync-badge{display:flex;align-items:center;gap:5px;font-size:11px;color:var(--text3);background:var(--surface);border:0.5px solid var(--border-strong);border-radius:20px;padding:5px 9px;}
.sync-dot{width:6px;height:6px;border-radius:50%;background:var(--text3);}
.sync-dot.on{background:var(--income);}
.ibtn{background:var(--surface);border:0.5px solid var(--border-strong);border-radius:var(--rs);padding:6px 10px;font-size:11px;font-family:'Cairo',sans-serif;color:var(--text);cursor:pointer;font-weight:600;}
.sec{font-size:11px;font-weight:700;color:var(--text3);padding:4px 20px 8px;}
/* Cards */
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:9px;padding:0 20px 14px;}
.card{background:var(--surface);border:0.5px solid var(--border);border-radius:var(--r);padding:14px;position:relative;overflow:hidden;}
.card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;}
.card.ib::before{background:linear-gradient(90deg,#185FA5,#60A5FA);}
.card.vc::before{background:linear-gradient(90deg,#E60000,#FF6B6B);}
.card.ca::before{background:linear-gradient(90deg,#7C3AED,#A78BFA);}
.card-icon{font-size:17px;margin-bottom:5px;display:block;}
.card-name{font-size:11px;font-weight:700;margin-bottom:8px;}
.bal{font-size:22px;font-weight:700;}
.bal.pos{color:var(--income);}
.bal.neg{color:var(--expense);}
.bal.zero{color:var(--text3);}
.breakdown{display:flex;gap:12px;margin-top:7px;padding-top:7px;border-top:0.5px solid var(--border);}
.bk-item{display:flex;flex-direction:column;gap:1px;}
.bk-lbl{font-size:9px;color:var(--text3);}
.bk-val{font-size:11px;font-weight:700;}
.bk-val.w{color:var(--work);}
.bk-val.p{color:var(--personal);}
/* Summary */
.sum-row{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:0 20px 14px;}
.metric{background:var(--surface);border:0.5px solid var(--border);border-radius:var(--r);padding:10px 12px;}
.metric-lbl{font-size:10px;color:var(--text2);margin-bottom:2px;}
.metric-val{font-size:17px;font-weight:700;}
/* Debt */
.debt-row{display:grid;grid-template-columns:1fr 1fr;gap:9px;padding:0 20px 14px;}
.dcard{background:var(--surface);border:0.5px solid var(--border);border-radius:var(--r);padding:12px 14px;}
.dcard-lbl{font-size:11px;color:var(--text2);margin-bottom:4px;}
.dcard-val{font-size:16px;font-weight:700;}
.dcard-val.owe{color:var(--debt-owe);}
.dcard-val.own{color:var(--debt-own);}
/* Form */
.fw{padding:0 20px 14px;}
.fc{background:var(--surface);border:0.5px solid var(--border);border-radius:var(--r);padding:15px;}
.ftabs{display:flex;gap:4px;margin-bottom:14px;flex-wrap:wrap;}
.ftab{flex:1;min-width:55px;padding:7px 3px;border-radius:var(--rs);border:0.5px solid var(--border-strong);background:transparent;color:var(--text2);font-size:11px;font-family:'Cairo',sans-serif;font-weight:600;cursor:pointer;text-align:center;}
.ftab.on{background:var(--text);color:var(--bg);}
.fsec{display:none;}
.fsec.on{display:block;}
.fg{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-bottom:9px;}
.fg-item{display:flex;flex-direction:column;gap:4px;}
.fg-item.full{grid-column:1/-1;}
.fg-item label{font-size:11px;color:var(--text2);font-weight:600;}
select,input,textarea{width:100%;padding:8px 11px;border-radius:var(--rs);border:0.5px solid var(--border-strong);background:var(--surface2);color:var(--text);font-size:13px;font-family:'Cairo',sans-serif;outline:none;}
textarea{resize:vertical;min-height:75px;line-height:1.6;}
.sbtn{width:100%;padding:12px;border-radius:var(--rs);border:none;background:var(--text);color:var(--bg);font-size:14px;font-family:'Cairo',sans-serif;font-weight:700;cursor:pointer;margin-top:6px;}
.sbtn:disabled{opacity:.5;cursor:not-allowed;}
.sbtn.blue{background:var(--work);color:#fff;}
.sbtn.red{background:var(--debt-owe);color:#fff;}
.sbtn.amber{background:var(--note);color:#fff;}
.sbtn.navy{background:var(--commit);color:#fff;}
.sbtn.green{background:var(--repure);color:#fff;}
.toast{display:none;text-align:center;padding:9px;border-radius:var(--rs);margin-top:9px;font-size:12px;font-weight:600;}
.toast.on{display:block;}
.toast.ok{background:var(--personal-bg);color:var(--personal);}
.toast.err{background:var(--debt-owe-bg);color:var(--debt-owe);}
.trbox{background:var(--surface2);border-radius:var(--rs);padding:10px 12px;margin-bottom:10px;}
.trbox-lbl{font-size:11px;font-weight:700;color:var(--text2);margin-bottom:8px;}
/* List */
.txlist{padding:0 20px;display:flex;flex-direction:column;gap:6px;}
.dlbl{font-size:11px;color:var(--text3);font-weight:700;padding:5px 0 2px;}
.ti{background:var(--surface);border:0.5px solid var(--border);border-radius:var(--rs);padding:10px 12px;display:flex;align-items:center;gap:9px;}
.ti-icon{font-size:15px;flex-shrink:0;}
.ti-body{flex:1;min-width:0;}
.ti-desc{font-size:13px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.ti-meta{font-size:10px;color:var(--text2);margin-top:2px;display:flex;gap:3px;flex-wrap:wrap;}
.badge{font-size:9px;padding:1px 6px;border-radius:20px;font-weight:700;}
.badge.w{background:var(--work-bg);color:var(--work);}
.badge.p{background:var(--personal-bg);color:var(--personal);}
.badge.ib{background:#E6F1FB;color:#185FA5;}
.badge.vc{background:#FEE2E2;color:#C0392B;}
.badge.ca{background:var(--cash-bg);color:var(--cash);}
.badge.rp{background:var(--repure-bg);color:var(--repure);}
.ti-amt{font-size:13px;font-weight:700;flex-shrink:0;}
.ti-amt.inc{color:var(--income);}
.ti-amt.exp{color:var(--expense);}
.ti-amt.tr{color:var(--work);}
.ti-del{background:none;border:none;color:var(--text3);font-size:16px;cursor:pointer;padding:3px 5px;flex-shrink:0;}
.empty{text-align:center;padding:32px 20px;color:var(--text3);font-size:13px;line-height:2;}
/* Filter */
.frow{display:flex;gap:6px;padding:0 20px 11px;overflow-x:auto;}
.frow::-webkit-scrollbar{display:none;}
.fchip{padding:5px 12px;border-radius:20px;border:0.5px solid var(--border-strong);background:transparent;color:var(--text2);font-size:12px;font-family:'Cairo',sans-serif;font-weight:600;cursor:pointer;white-space:nowrap;flex-shrink:0;}
.fchip.on{background:var(--text);color:var(--bg);}
/* Notes */
.nlist{padding:0 20px;display:flex;flex-direction:column;gap:8px;}
.ni{background:var(--surface);border:0.5px solid var(--border);border-radius:var(--r);padding:13px 14px;}
.ni.note-t{border-right:3px solid var(--note);}
.ni.commit-t{border-right:3px solid var(--commit);}
.ni-hdr{display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;}
.ni-badge{font-size:10px;padding:2px 8px;border-radius:20px;font-weight:700;}
.ni-badge.note{background:var(--note-bg);color:var(--note);}
.ni-badge.commit{background:var(--commit-bg);color:var(--commit);}
.ni-rem{font-size:10px;color:var(--text3);}
.ni-rem.due{color:var(--debt-owe);font-weight:700;}
.ni-rem.today{color:var(--note);font-weight:700;}
.ni-txt{font-size:13px;line-height:1.7;white-space:pre-wrap;}
.ni-foot{display:flex;align-items:center;justify-content:space-between;margin-top:8px;}
.ni-date{font-size:10px;color:var(--text3);}
.ni-done{background:var(--personal-bg);border:none;border-radius:var(--rs);padding:4px 10px;font-size:10px;font-family:'Cairo',sans-serif;color:var(--personal);cursor:pointer;font-weight:700;}
.ni-del{background:none;border:none;color:var(--text3);font-size:15px;cursor:pointer;padding:2px 5px;}
.rem-banner{margin:0 20px 12px;padding:10px 14px;background:var(--debt-owe-bg);border-radius:var(--rs);border:0.5px solid var(--debt-owe);display:none;}
.rem-banner.on{display:block;}
.rem-title{font-size:12px;font-weight:700;color:var(--debt-owe);margin-bottom:4px;}
/* Report */
.rep-sec{padding:0 20px;}
.rep-card{background:var(--surface);border:0.5px solid var(--border);border-radius:var(--r);padding:14px;margin-bottom:10px;}
.rep-title{font-size:13px;font-weight:700;margin-bottom:10px;}
.rep-row{display:flex;justify-content:space-between;padding:5px 0;border-bottom:0.5px solid var(--border);}
.rep-row:last-child{border-bottom:none;font-weight:700;padding-top:8px;}
.rep-lbl{font-size:12px;color:var(--text2);}
.rep-val{font-size:12px;font-weight:600;}
.rep-val.w{color:var(--work);}.rep-val.p{color:var(--personal);}
.rep-val.inc{color:var(--income);}.rep-val.exp{color:var(--expense);}
.rep-val.pos{color:var(--income);}.rep-val.neg{color:var(--expense);}
/* RePure */
.rp-card{background:var(--surface);border:0.5px solid var(--border);border-radius:var(--r);padding:14px;margin:0 20px 14px;position:relative;overflow:hidden;}
.rp-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,#2D6A4F,#52B788);}
.rp-stats{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-top:10px;}
.rp-stat{background:var(--surface2);border-radius:var(--rs);padding:8px;text-align:center;}
.rp-stat-lbl{font-size:10px;color:var(--text2);margin-bottom:3px;}
.rp-stat-val{font-size:13px;font-weight:700;}
/* Nav */
.nav{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:100%;max-width:480px;background:var(--surface);border-top:0.5px solid var(--border);display:flex;z-index:100;padding-bottom:env(safe-area-inset-bottom);}
.nav-btn{flex:1;padding:11px 3px 9px;border:none;background:none;font-family:'Cairo',sans-serif;font-size:9px;font-weight:600;color:var(--text3);cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:2px;position:relative;}
.nav-btn.on{color:var(--work);}
.nav-icon{font-size:17px;line-height:1;}
.nbadge{position:absolute;top:8px;right:calc(50% - 16px);background:var(--debt-owe);color:#fff;font-size:9px;font-weight:700;border-radius:20px;padding:1px 5px;min-width:16px;text-align:center;}
.tab{display:none;}
.tab.on{display:block;}
.loading{position:fixed;inset:0;background:var(--bg);display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:999;gap:10px;}
.loading.hidden{display:none;}
.spin{width:30px;height:30px;border:3px solid var(--border);border-top-color:var(--work);border-radius:50%;animation:spin .8s linear infinite;}
@keyframes spin{to{transform:rotate(360deg);}}
.cur-tog{display:flex;gap:6px;margin-bottom:9px;}
.cur-btn{flex:1;padding:6px;border-radius:var(--rs);border:0.5px solid var(--border-strong);background:transparent;color:var(--text2);font-size:12px;font-family:'Cairo',sans-serif;font-weight:600;cursor:pointer;text-align:center;}
.cur-btn.on{background:var(--text);color:var(--bg);}
</style>
</head>
<body>
<div class="loading" id="loading">
  <div style="font-size:38px">💰</div>
  <div style="font-size:19px;font-weight:700;">My Wallets</div>
  <div class="spin"></div>
  <div style="font-size:13px;color:var(--text2);" id="load-msg">جاري الاتصال...</div>
</div>

<div class="app" id="app" style="display:none">
  <header>
    <div>
      <div class="logo-text">My Wallets 💰</div>
      <div class="logo-sub" id="today"></div>
    </div>
    <div style="display:flex;gap:7px;align-items:center;">
      <div class="sync-badge"><div class="sync-dot" id="sdot"></div><span id="slbl">...</span></div>
      <button class="ibtn" onclick="doCSV()">CSV</button>
    </div>
  </header>

  <!-- OVERVIEW -->
  <div class="tab on" id="t-overview">
    <div class="sec">المحافظ الرقمية</div>
    <div class="grid2">
      <div class="card ib">
        <span class="card-icon">💳</span>
        <div class="card-name">إنستا باي</div>
        <div class="bal" id="ib-bal">0 ج</div>
        <div class="breakdown">
          <div class="bk-item"><span class="bk-lbl">شغل</span><span class="bk-val w" id="ib-w">0</span></div>
          <div class="bk-item"><span class="bk-lbl">شخصي</span><span class="bk-val p" id="ib-p">0</span></div>
        </div>
      </div>
      <div class="card vc">
        <span class="card-icon">📱</span>
        <div class="card-name">فودافون كاش</div>
        <div class="bal" id="vc-bal">0 ج</div>
        <div class="breakdown">
          <div class="bk-item"><span class="bk-lbl">شغل</span><span class="bk-val w" id="vc-w">0</span></div>
          <div class="bk-item"><span class="bk-lbl">شخصي</span><span class="bk-val p" id="vc-p">0</span></div>
        </div>
      </div>
      <div class="card ca" style="grid-column:1/-1">
        <span class="card-icon">💵</span>
        <div class="card-name">كاش (جنيه)</div>
        <div style="display:flex;align-items:center;justify-content:space-between;">
          <div class="bal" id="ca-bal">0 ج</div>
          <div class="breakdown">
            <div class="bk-item"><span class="bk-lbl">شغل</span><span class="bk-val w" id="ca-w">0</span></div>
            <div class="bk-item"><span class="bk-lbl">شخصي</span><span class="bk-val p" id="ca-p">0</span></div>
          </div>
        </div>
      </div>
    </div>

    <div class="sec">إجماليات</div>
    <div class="sum-row">
      <div class="metric"><div class="metric-lbl">💼 شغل</div><div class="metric-val" id="tot-w" style="color:var(--work)">0 ج</div></div>
      <div class="metric"><div class="metric-lbl">🏠 شخصي</div><div class="metric-val" id="tot-p" style="color:var(--personal)">0 ج</div></div>
    </div>

    <div class="sec">الديون</div>
    <div class="debt-row">
      <div class="dcard">
        <div class="dcard-lbl">🔴 عليّ</div>
        <div class="dcard-val owe" id="d-owe-egp">0 ج</div>
        <div class="dcard-val owe" id="d-owe-usd" style="font-size:12px;margin-top:2px;">0 $</div>
        <div style="font-size:10px;color:var(--text3);margin-top:3px;" id="d-owe-cnt">0 دين</div>
      </div>
      <div class="dcard">
        <div class="dcard-lbl">🟢 لي عند الناس</div>
        <div class="dcard-val own" id="d-own-egp">0 ج</div>
        <div class="dcard-val own" id="d-own-usd" style="font-size:12px;margin-top:2px;">0 $</div>
        <div style="font-size:10px;color:var(--text3);margin-top:3px;" id="d-own-cnt">0 دين</div>
      </div>
    </div>

    <div class="sec">حركات اليوم</div>
    <div class="txlist" id="today-list"></div>
  </div>

  <!-- ADD -->
  <div class="tab" id="t-add">
    <div class="fw">
      <div class="fc">
        <div class="ftabs">
          <button class="ftab on" onclick="switchFTab('tx',this)">حركة</button>
          <button class="ftab" onclick="switchFTab('tr',this)">تحويل</button>
          <button class="ftab" onclick="switchFTab('debt',this)">دين</button>
          <button class="ftab" onclick="switchFTab('note',this)">ملاحظة</button>
          <button class="ftab" onclick="switchFTab('commit',this)">التزام</button>
        </div>

        <!-- TX FORM -->
        <div class="fsec on" id="fs-tx">
          <div class="fg">
            <div class="fg-item"><label>الحساب</label>
              <select id="f-wal"><option value="instapay">💳 إنستا باي</option><option value="vodafone">📱 فودافون كاش</option><option value="cash">💵 كاش</option></select>
            </div>
            <div class="fg-item"><label>التصنيف</label>
              <select id="f-cat"><option value="work">💼 شغل</option><option value="personal">🏠 شخصي</option></select>
            </div>
            <div class="fg-item"><label>النوع</label>
              <select id="f-typ"><option value="income">⬇ وارد</option><option value="expense">⬆ صادر</option></select>
            </div>
            <div class="fg-item"><label>المبلغ (ج)</label>
              <input type="number" id="f-amt" placeholder="0.00" min="0" step="0.01">
            </div>
            <div class="fg-item full"><label>البيان</label>
              <input type="text" id="f-dsc" placeholder="مثال: تحويل من عميل...">
            </div>
          </div>
          <button class="sbtn" id="btn-tx" onclick="doAddTx()">+ إضافة الحركة</button>
        </div>

        <!-- TRANSFER FORM -->
        <div class="fsec" id="fs-tr">
          <div class="trbox">
            <div class="trbox-lbl">من ↑</div>
            <div class="fg" style="margin-bottom:0">
              <div class="fg-item"><label>الحساب</label>
                <select id="tr-from-wal"><option value="instapay">💳 إنستا باي</option><option value="vodafone">📱 فودافون كاش</option><option value="cash">💵 كاش</option></select>
              </div>
              <div class="fg-item"><label>التصنيف</label>
                <select id="tr-from-cat"><option value="work">💼 شغل</option><option value="personal">🏠 شخصي</option></select>
              </div>
            </div>
          </div>
          <div class="trbox">
            <div class="trbox-lbl">إلى ↓</div>
            <div class="fg" style="margin-bottom:0">
              <div class="fg-item"><label>الحساب</label>
                <select id="tr-to-wal"><option value="vodafone">📱 فودافون كاش</option><option value="instapay">💳 إنستا باي</option><option value="cash">💵 كاش</option></select>
              </div>
              <div class="fg-item"><label>التصنيف</label>
                <select id="tr-to-cat"><option value="work">💼 شغل</option><option value="personal">🏠 شخصي</option></select>
              </div>
            </div>
          </div>
          <div class="fg">
            <div class="fg-item"><label>المبلغ (ج)</label><input type="number" id="tr-amt" placeholder="0.00" min="0" step="0.01"></div>
            <div class="fg-item"><label>البيان</label><input type="text" id="tr-dsc" placeholder="اختياري..."></div>
          </div>
          <button class="sbtn blue" id="btn-tr" onclick="doTransfer()">↔ تنفيذ التحويل</button>
        </div>

        <!-- DEBT FORM -->
        <div class="fsec" id="fs-debt">
          <div class="cur-tog">
            <button class="cur-btn on" id="dc-egp" onclick="setDC('EGP')">جنيه ج</button>
            <button class="cur-btn" id="dc-usd" onclick="setDC('USD')">دولار $</button>
          </div>
