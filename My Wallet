  var usd=d.currency==='USD';
  var sb=!d.settled?'<button class="ti-del" style="font-size:11px;color:var(--income);padding:3px 6px;" onclick="settleD(\''+d.id+'\')">✓</button>':'';
  return '<div class="ti"><div class="ti-icon">'+(d.type==='owe'?'🔴':'🟢')+'</div><div class="ti-body"><div class="ti-desc">'+(d.person||'شخص')+(d.settled?' <span style="font-size:9px;color:var(--income);">✓</span>':'')+'</div><div class="ti-meta">'+(usd?'<span class="badge" style="background:#FEF3C7;color:#B45309;">$</span>':'')+(d.desc||'')+' · '+(d.date?new Date(d.date).toLocaleDateString('ar-EG'):'')+'</div></div><div class="ti-amt '+(d.type==='owe'?'exp':'inc')+'">'+fmtF(Number(d.amount),usd)+'</div>'+sb+'<button class="ti-del" onclick="delDebt(\''+d.id+'\')">×</button></div>';
}

function checkRem(){
  var today=new Date();today.setHours(0,0,0,0);
  var due=notes.filter(function(n){
    if(n.done||!n.reminderDate) return false;
    var rd=new Date(n.reminderDate);rd.setHours(0,0,0,0);
    return rd<=today;
  });
  var badge=document.getElementById('nbadge');
  var banner=document.getElementById('rem-banner');
  if(due.length>0){
    badge.style.display='';badge.textContent=due.length;
    banner.classList.add('on');
    document.getElementById('rem-list').innerHTML=due.map(function(n){return '• '+n.text.substring(0,60);}).join('<br>');
  } else {badge.style.display='none';banner.classList.remove('on');}
}

