}

function renderHistory(){
  var searchEl=document.getElementById('hist-search');
  var searchQ=searchEl?searchEl.value.trim().toLowerCase():'';
  var list=txs.filter(function(t){
    var matchFilter=false;
    if(hFilter==='all') matchFilter=true;
    else if(hFilter==='transfer') matchFilter=(t.kind==='transfer'||t.type==='transfer');
    else matchFilter=(t.wallet===hFilter||t.to===hFilter||t.cat===hFilter);
    if(!matchFilter) return false;
    if(!searchQ) return true;
    var desc=(t.desc||'').toLowerCase();
    var amt=String(t.amount||'');
    return desc.includes(searchQ)||amt.includes(searchQ);
  });
  var el=document.getElementById('hist-list');
  if(!list.length){el.innerHTML='<div class="empty">لا توجد حركات</div>';return;}
  var g={};
  list.forEach(function(t){
    var k=t.date?new Date(t.date).toDateString():'x';
    if(!g[k]) g[k]={lbl:t.date?new Date(t.date).toLocaleDateString('ar-EG',{weekday:'long',year:'numeric',month:'long',day:'numeric'}):'',items:[]};
    g[k].items.push(t);
  });
  el.innerHTML=Object.values(g).map(function(x){return '<div class="dlbl">'+x.lbl+'</div>'+x.items.map(txRow).join('');}).join('<div style="height:5px"></div>');
}

