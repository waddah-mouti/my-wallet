// ============================================================
// REPORT
// ============================================================
function setRR(r){
  var now=new Date(),from,to;
  if(r==='today'){from=to=now;}
  else if(r==='yesterday'){var y=new Date(now);y.setDate(y.getDate()-1);from=to=y;}
  else if(r==='week'){var w=new Date(now);w.setDate(w.getDate()-6);from=w;to=now;}
  else{from=new Date(now.getFullYear(),now.getMonth(),1);to=now;}
  document.getElementById('rep-from').value=from.toISOString().split('T')[0];
  document.getElementById('rep-to').value=to.toISOString().split('T')[0];
}
function doReport(){
  var fv=document.getElementById('rep-from').value;
  var tv=document.getElementById('rep-to').value;
  if(!fv||!tv){toast('اختار التاريخ','err');return;}
  var from=new Date(fv);from.setHours(0,0,0,0);
  var to=new Date(tv);to.setHours(23,59,59,999);
  var list=txs.filter(function(t){return t.date&&new Date(t.date)>=from&&new Date(t.date)<=to;});
  if(!list.length){document.getElementById('rep-out').innerHTML='<div class="empty">لا توجد حركات في هذه الفترة</div>';return;}
  var b=calcBal(list);
  var wals=[['instapay','💳 إنستا باي'],['vodafone','📱 فودافون كاش'],['cash','💵 كاش']];
  var html='';
  wals.forEach(function(m){
    var k=m[0],nm=m[1];
    var w=b[k].work,p=b[k].personal,tot=w+p;
    if(w===0&&p===0) return;
    html+='<div class="rep-card"><div class="rep-title">'+nm+'</div><div class="rep-row"><span class="rep-lbl">💼 شغل</span><span class="rep-val w">'+fmtF(w)+'</span></div><div class="rep-row"><span class="rep-lbl">🏠 شخصي</span><span class="rep-val p">'+fmtF(p)+'</span></div><div class="rep-row"><span class="rep-lbl">الإجمالي</span><span class="rep-val '+(tot>=0?'pos':'neg')+'">'+fmtF(tot)+'</span></div></div>';
  });
  var inc=list.filter(function(t){return t.type==='income'&&t.kind!=='transfer';}).reduce(function(s,t){return s+Number(t.amount);},0);
  var exp=list.filter(function(t){return t.type==='expense'&&t.kind!=='transfer';}).reduce(function(s,t){return s+Number(t.amount);},0);
  var net=inc-exp;
  html+='<div class="rep-card"><div class="rep-title">📊 ملخص الفترة</div><div class="rep-row"><span class="rep-lbl">⬇ وارد</span><span class="rep-val inc">+'+fmtF(inc)+'</span></div><div class="rep-row"><span class="rep-lbl">⬆ صادر</span><span class="rep-val exp">-'+fmtF(exp)+'</span></div><div class="rep-row"><span class="rep-lbl">الصافي</span><span class="rep-val '+(net>=0?'pos':'neg')+'">'+(net>=0?'+':'')+fmtF(net)+'</span></div></div>';
  var trs=list.filter(function(t){return t.kind==='transfer'||t.type==='transfer';});
  if(trs.length>0){
    var trRows=trs.map(function(t){
      var fromW=WN[t.wallet]||t.wallet;
      var toW=t.to?(WN[t.to]||t.to):fromW;
      var fromC=(t.fromCat||t.cat||'work')==='work'?'شغل':'شخصي';
      var toC=(t.toCat||t.cat||'work')==='work'?'شغل':'شخصي';
      var d=t.date?new Date(t.date).toLocaleDateString('ar-EG'):'';
      return '<div class="rep-row"><span class="rep-lbl">'+d+' | '+(t.desc||'تحويل')+'</span><span class="rep-val tr">'+fromW+' '+fromC+' ← '+toW+' '+toC+' | '+fmtF(Number(t.amount))+'</span></div>';
    }).join('');
    html+='<div class="rep-card"><div class="rep-title">↔ التحويلات ('+trs.length+')</div>'+trRows+'</div>';
  }
  document.getElementById('rep-out').innerHTML=html;
}

// ============================================================
// UI HELPERS
// ============================================================
function toast(msg,t){var el=document.getElementById('toast');el.textContent=msg;el.className='toast on '+t;setTimeout(function(){el.classList.remove('on');},3000);}
function toast2(msg,t){var el=document.getElementById('toast2');el.textContent=msg;el.className='toast on '+t;setTimeout(function(){el.classList.remove('on');},3000);}
function switchFTab(name,btn){
  document.querySelectorAll('.ftab').forEach(function(b){b.classList.remove('on');});
  document.querySelectorAll('.fsec').forEach(function(s){s.classList.remove('on');});
  btn.classList.add('on');
  document.getElementById('fs-'+name).classList.add('on');
}
function setF(f,btn){hFilter=f;document.querySelectorAll('.fchip').forEach(function(c){c.classList.remove('on');});btn.classList.add('on');renderHistory();}
function setDC(c){dCur=c;document.getElementById('dc-egp').className='cur-btn'+(c==='EGP'?' on':'');document.getElementById('dc-usd').className='cur-btn'+(c==='USD'?' on':'');document.getElementById('dt-aml').textContent=c==='USD'?'المبلغ ($)':'المبلغ (ج)';}
function setCC(c){cCur=c;document.getElementById('cc-egp').className='cur-btn'+(c==='EGP'?' on':'');document.getElementById('cc-usd').className='cur-btn'+(c==='USD'?' on':'');document.getElementById('cm-aml').textContent=c==='USD'?'المبلغ ($) — اختياري':'المبلغ (ج) — اختياري';}
function showTab(name,btn){
  document.querySelectorAll('.tab').forEach(function(t){t.classList.remove('on');});
  document.querySelectorAll('.nav-btn').forEach(function(b){b.classList.remove('on');});
  document.getElementById('t-'+name).classList.add('on');
  if(btn) btn.classList.add('on');
  if(name==='history') renderHistory();
  if(name==='overview') render();
  if(name==='notes'){renderNotes();checkRem();}
  if(name==='repure') renderRepure();
}
function doCSV(){
  if(!txs.length&&!debts.length){alert('لا توجد بيانات');return;}
  var h='التاريخ,النوع,الحساب,من تصنيف,إلى حساب,إلى تصنيف,المبلغ,البيان\n';
  var rows=[
    ...txs.map(function(t){var d=t.date?new Date(t.date).toLocaleDateString('ar-EG'):'';var w=WN[t.wallet]||t.wallet;var c=t.cat==='work'?'شغل':'شخصي';var isTr=t.kind==='transfer'||t.type==='transfer';var tp=isTr?'تحويل':t.type==='income'?'وارد':'صادر';var toW=t.to?(WN[t.to]||t.to):'';var toC=t.toCat?(t.toCat==='work'?'شغل':'شخصي'):'';var fromC=(t.fromCat||t.cat||'work')==='work'?'شغل':'شخصي';return d+','+tp+','+w+','+fromC+','+toW+','+toC+','+t.amount+',"'+(t.desc||'')+'"';}),
    ...rps.map(function(t){var d=t.date?new Date(t.date).toLocaleDateString('ar-EG'):'';return d+',RePure,,'+t.cat+','+( t.type==='income'?'إيراد':'مصروف')+','+t.amount+',"'+(t.desc||'')+'"';}),
    ...debts.map(function(d){var dt=d.date?new Date(d.date).toLocaleDateString('ar-EG'):'';return dt+',دين,'+(d.person||'')+',,'+( d.type==='owe'?'عليّ':'لي')+','+d.amount+',"'+(d.desc||'')+'"';})
  ].join('\n');
  var blob=new Blob(['\uFEFF'+h+rows],{type:'text/csv;charset=utf-8'});
  var a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='my-wallets-'+new Date().toLocaleDateString('ar-EG').replace(/\//g,'-')+'.csv';a.click();
}
