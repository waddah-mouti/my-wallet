// CORE BALANCE CALC - THE FIX
// Simple direct calculation: income=+ expense=- transfer=move
// ============================================================
function calcBal(list){
  var b={
    instapay:{work:0,personal:0},
    vodafone:{work:0,personal:0},
    cash:{work:0,personal:0}
  };
  for(var i=0;i<list.length;i++){
    var t=list[i];
    var wal=t.wallet;
    var cat=t.cat||'work';
    var amt=Number(t.amount)||0;
    if(t.kind==='transfer' || t.type==='transfer'){
      var fw=t.wallet;
      var tw2=t.to||t.wallet;
      var fc=t.fromCat||t.cat||'work';
      var tc=t.toCat||t.cat||'work';
      if(b[fw]) b[fw][fc] = b[fw][fc] - amt;
      if(b[tw2]) b[tw2][tc] = b[tw2][tc] + amt;
    } else if(t.type==='income'){
      if(b[wal]) b[wal][cat] = b[wal][cat] + amt;
    } else if(t.type==='expense'){
      if(b[wal]) b[wal][cat] = b[wal][cat] - amt;
    }
    // anything else is ignored
  }
  return b;
}

function fmt(n){
  var s=n<0?'-':'';
  var a=Math.abs(n);
  var v;
  if(a>=1000000) v=(a/1000000).toFixed(1)+'م';
  else if(a>=1000) v=(a/1000).toFixed(1)+'ك';
  else v=a.toFixed(0);
  return s+v;
}
function fmtF(n,usd){
  var a=Math.abs(n).toLocaleString('ar-EG',{minimumFractionDigits:0,maximumFractionDigits:2});
  return (n<0?'-':'')+a+(usd?' $':' ج');
}
function bc(n){return n>0?'pos':n<0?'neg':'';}
function balCls(n){return n>0?'pos':n<0?'neg':'zero';}

function render(){
  var b=calcBal(txs);
  var keys=['instapay','vodafone','cash'];
  var pids=['ib','vc','ca'];
  for(var i=0;i<3;i++){
    var k=keys[i], pid=pids[i];
    var w=b[k].work, p=b[k].personal, tot=w+p;
    var el=document.getElementById(pid+'-bal');
    el.textContent=fmtF(tot);
    el.className='bal '+balCls(tot);
    document.getElementById(pid+'-w').textContent=fmt(w)+' ج';
    document.getElementById(pid+'-p').textContent=fmt(p)+' ج';
  }
  // Totals = exact sum of account balances
  var tw=b.instapay.work+b.vodafone.work+b.cash.work;
  var tp=b.instapay.personal+b.vodafone.personal+b.cash.personal;
  var elw=document.getElementById('tot-w');
  var elp=document.getElementById('tot-p');
  elw.textContent=fmtF(tw);
  elw.style.color=tw<0?'var(--expense)':'var(--work)';
  elp.textContent=fmtF(tp);
  elp.style.color=tp<0?'var(--expense)':'var(--personal)';
  renderDebt();
  renderToday();
  renderRepure();
  checkRem();
}

function renderDebt(){
  var owe=debts.filter(function(d){return d.type==='owe'&&!d.settled;});
  var own=debts.filter(function(d){return d.type==='own'&&!d.settled;});
  var oEGP=0,oUSD=0,nEGP=0,nUSD=0;
  owe.forEach(function(d){if(d.currency==='USD')oUSD+=Number(d.amount)||0;else oEGP+=Number(d.amount)||0;});
  own.forEach(function(d){if(d.currency==='USD')nUSD+=Number(d.amount)||0;else nEGP+=Number(d.amount)||0;});
  document.getElementById('d-owe-egp').textContent=fmtF(oEGP);
  document.getElementById('d-owe-usd').textContent=fmtF(oUSD,true);
  document.getElementById('d-own-egp').textContent=fmtF(nEGP);
  document.getElementById('d-own-usd').textContent=fmtF(nUSD,true);
  document.getElementById('d-owe-cnt').textContent=owe.length+' دين';
  document.getElementById('d-own-cnt').textContent=own.length+' دين';
}

